{
  "name": "deepline-assistant",
  "version": "1.0.0",
  "description": "Open-source Chrome side panel that runs Deepline plays on the page you are viewing and shows the results from your Deepline table. Reads only the tab URL and title.",
  "license": "MIT",
  "author": "Deepline (https://deepline.com)",
  "homepage": "https://deepline.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "TEST_BUILD=1 node scripts/build.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs",
    "lint": "eslint src tests scripts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.2.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
